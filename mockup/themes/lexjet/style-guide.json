  "colors": {
    "primary": "#002855",
    "secondary": "#007BFF",
    "success": "#44B44F",
    "warning": "#FFC107",
    "danger": "#B12704",
    "info": "#5B6574",
    "text": "#000000",
    "heading": "#000000",
    "palette": [
      "#000000",
      "#002855",
      "#007BFF",
      "#44B44F",
      "#5B6574",
      "#686868",
      "#AAAAAA",
