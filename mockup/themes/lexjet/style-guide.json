      "#B12704",
      "#FFC107"
    ]
  },
  "spacing": {
    "2": "2em"
  },
  "borderRadius": {
    "DEFAULT": "4px",
    "lg": "8px"
  },
  "boxShadow": {
    "card": "0 4px 12px rgba(34, 46, 60, 0.04)"
  },
  "buttons": {
    "shared": {
      "display": "inline-flex",
      "alignItems": "center",
      "justifyContent": "center",
      "textTransform": "uppercase",
      "height": "34px",
      "borderRadius": "4px",
      "cursor": "pointer",
      "transition": "all 0.2s ease-in-out"
    },
    "primary": {
      "fontSize": "14px",
      "fontWeight": "600",
      "lineHeight": "18px",
      "textTransform": "uppercase",
      "border": "2px solid black",
      "padding": ".375rem .75rem",
      "textColor": "#000000",
      "maxWidth": "300px",
      "whiteSpace": "nowrap",
      "hover": {
        "color": "#007BFF",
        "borderColor": "#007BFF"
      }
    },
    "secondary": {
      "backgroundColor": "#002855",
      "textColor": "#ffffff",
      "fontWeight": "600",
      "fontSize": "16px",
      "padding": "12px 24px",
      "borderRadius": "4px",
      "hover": {
        "backgroundColor": "#005fcc"
      }
    },
    "outline": {
      "backgroundColor": "transparent",
      "textColor": "#002855",
      "fontWeight": "600",
      "fontSize": "16px",
      "padding": "12px 24px",
      "border": "2px solid #002855",
      "borderRadius": "4px",
      "hover": {
        "backgroundColor": "#F5F5F5"
      }
    },
    "link": {
      "fontSize": "14px",
      "fontWeight": "600",
      "lineHeight": "18px",
      "height": "24px",
      "textTransform": "uppercase",
      "textColor": "#000000",
      "backgroundColor": "transparent",
      "padding": "0",
      "borderRadius": "0px",
      "hover": {
        "color": "#007BFF"
      }
    }
  }
