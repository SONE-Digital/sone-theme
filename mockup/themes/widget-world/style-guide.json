{
  "brand": "Widget World",
  "fonts": {
    "family": {
      "sans": [
        "\"Inter\"",
        "system-ui",
        "sans-serif"
      ]
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "size": {
      "h1": {
        "fontSize": "3rem",
        "fontWeight": "700",
        "lineHeight": "1.2",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0px 0px 10px 0px",
        "label": {
          "fontSize": "48px",
          "fontWeight": "Bold"
        }
      },
      "h2": {
        "fontSize": "2.25rem",
        "fontWeight": "600",
        "lineHeight": "1.3",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0px 0px 20px 0px",
        "label": {
          "fontSize": "36px",
          "fontWeight": "Semi Bold"
        }
      },
      "h3": {
        "fontSize": "1.875rem",
        "fontWeight": "600",
        "lineHeight": "1.3",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0px 0px 10px 0px",
        "label": {
          "fontSize": "30px",
          "fontWeight": "Semi Bold"
        }
      },
      "h4": {
        "fontSize": "1.5rem",
        "fontWeight": "600",
        "lineHeight": "1.4",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0",
        "label": {
          "fontSize": "24px",
          "fontWeight": "Semi Bold"
        }
      },
      "h5": {
        "fontSize": "1.25rem",
        "fontWeight": "600",
        "lineHeight": "1.4",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0",
        "label": {
          "fontSize": "20px",
          "fontWeight": "Semi Bold"
        }
      },
      "h6": {
        "fontSize": "1.125rem",
        "fontWeight": "600",
        "lineHeight": "1.5",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0",
        "label": {
          "fontSize": "18px",
          "fontWeight": "Semi Bold"
        }
      },
      "base": {
        "fontSize": "1rem",
        "fontWeight": "400",
        "lineHeight": "1.5",
        "letterSpacing": "0",
        "textTransform": "none",
        "padding": "0",
        "label": {
          "fontSize": "16px",
          "fontWeight": "Regular"
        }
      }
    }
  },
  "colors": {
    "primary": "#2563eb",
    "secondary": "#7c3aed",
    "success": "#059669",
    "warning": "#f59e0b",
    "danger": "#dc2626",
    "info": "#6b7280",
    "text": "#111827",
    "heading": "#111827",
    "palette": [
      "#111827",
      "#2563eb",
      "#7c3aed",
      "#059669",
      "#f59e0b",
      "#dc2626",
      "#6b7280",
      "#9ca3af",
      "#d1d5db",
      "#f3f4f6",
      "#ffffff"
    ]
  },
  "spacing": {
    "2": "2em"
  },
  "borderRadius": {
    "DEFAULT": "8px",
    "lg": "12px"
  },
  "boxShadow": {
    "card": "0 4px 12px rgba(0, 0, 0, 0.1)"
  },
  "buttons": {
    "shared": {
      "display": "inline-flex",
      "alignItems": "center",
      "justifyContent": "center",
      "textTransform": "none",
      "height": "40px",
      "borderRadius": "8px",
      "cursor": "pointer",
      "transition": "all 0.2s ease-in-out"
    },
    "primary": {
      "backgroundColor": "#2563eb",
      "textColor": "#ffffff",
      "fontWeight": "600",
      "fontSize": "16px",
      "padding": "12px 24px",
      "hover": {
        "backgroundColor": "#1d4ed8"
      }
    },
    "secondary": {
      "backgroundColor": "transparent",
      "textColor": "#2563eb",
      "fontWeight": "600",
      "fontSize": "16px",
      "padding": "12px 24px",
      "border": "2px solid #2563eb",
      "hover": {
        "backgroundColor": "#eff6ff"
      }
    }
  }
}