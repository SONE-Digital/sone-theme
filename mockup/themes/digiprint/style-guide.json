    "success": "#153977",
    "warning": "#FFC107",
    "danger": "#DC3545",
    "info": "#6c757d",
    "text": "#333333",
    "heading": "#000000",
    "palette": [
    "#8BBA09",
    "#153977",
    "#000000",
    "#FFFFFF",
    "#BA098B",
    "#774015",
    "#A8CF4A",
