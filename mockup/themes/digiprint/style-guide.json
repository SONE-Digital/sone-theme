  },
  "spacing": {
    "2": "2em"
  },
  "borderRadius": {
    "DEFAULT": "4px",
    "lg": "8px"
  },
  "boxShadow": {
    "card": "0 4px 12px rgba(34, 46, 60, 0.04)"
  },
  "buttons": {
    "shared": {
      "display": "inline-flex",
      "alignItems": "center",
      "justifyContent": "center",
      "height": "34px",
      "borderRadius": "4px",
      "cursor": "pointer",
      "transition": "all 0.2s ease-in-out"
    },
    "primary": {
      "fontSize": "14px",
      "fontWeight": "600",
      "lineHeight": "18px",
      "textTransform": "uppercase",
      "border": "2px solid #6c9006",
      "backgroundColor": "#8BBA09",
      "padding": ".375rem .75rem",
      "textColor": "#FFFFFF",
      "maxWidth": "300px",
      "whiteSpace": "nowrap",
      "hover": {
        "color": "#FFFFFF",
        "borderColor": "#8BBA09",
        "backgroundColor": "#6c9006"
      }
    },
    "secondary": {
      "backgroundColor": "#FF8C00",
      "textColor": "#ffffff",
      "fontWeight": "600",
      "fontSize": "16px",
      "padding": "12px 24px",
      "borderRadius": "4px",
      "hover": {
        "backgroundColor": "#E67E22"
      }
    },
    "outline": {
      "backgroundColor": "transparent",
      "textColor": "#3366CC",
      "fontWeight": "600",
      "fontSize": "16px",
      "padding": "12px 24px",
      "border": "2px solid #3366CC",
      "borderRadius": "4px",
      "hover": {
        "backgroundColor": "#F8F8F8"
      }
    },
    "link": {
      "fontSize": "14px",
      "fontWeight": "600",
      "lineHeight": "18px",
      "height": "24px",
      "textTransform": "uppercase",
      "textColor": "#3366CC",
      "backgroundColor": "transparent",
      "padding": "0",
      "borderRadius": "0px",
      "hover": {
        "color": "#FF8C00",
        "borderBottom": "2px solid #FF8C00"
      }
    }
  }
}